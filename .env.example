# Host-local development. Docker Compose injects the equivalent URL with hostname `db`.
DATABASE_URL=postgresql+psycopg://solar_forge_boards:solar_forge_boards@localhost:5432/solar_forge_boards
FLASK_SECRET_KEY=replace-me

# Optional GitHub token for private repositories and higher API limits.
GITHUB_TOKEN=

OUTBOX_URL=

OUTBOX_TOKEN=

OUTBOX_EVENT_TYPES=
